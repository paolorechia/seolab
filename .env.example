# ── GitHub SSO Auth ──────────────────────────────────────────────────
# Pass this as a Docker env var at runtime:
#   docker run -e GITHUB_TOKEN=ghp_xxxx your-image
#
# To get a token that works with SSO:
#   1. gh auth login
#      (this triggers the browser-based SSO flow)
#   2. Copy the token and use it as GITHUB_TOKEN
#
# Or use a GitHub App token (ghs_xxxx) that has repo scope.

GITHUB_TOKEN=ghp_your_personal_access_token_here
